{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["RUNNER_OS", "RUNNER_ARCH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": ["VERCEL_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "box#build": {
      "outputs": ["bin/**"]
    },
    "lint": {},
    "test": {},
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
